  "item": [
    {
      "name": "Preparación - consultar categorías",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/categorias"
      }
    },
    {
      "name": "Preparación - consultar productos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/productos?pagina=0&tamanio=100&ordenarPor=nombre&direccion=asc"
      }
    },
    {
      "name": "A-01 - Alta válida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/productos",
        "description": "Categoría activa; SPA: POST 201 y fila con categoría",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"S8 A-01 {{$timestamp}}\",\n  \"precio\": 5.5,\n  \"stock\": 10,\n  \"estado\": true,\n  \"categoriaId\": {{catActiva}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('A-01: HTTP 201', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
