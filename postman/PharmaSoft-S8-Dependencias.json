          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('A-06: HTTP 400', function () { pm.response.to.have.status(400); });",
              "pm.test('Dos campos inválidos', function () { const e = pm.response.json().validationErrors; pm.expect(e).to.have.property('precio'); pm.expect(e).to.have.property('stock'); });"
            ]
          }
