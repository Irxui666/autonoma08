        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"S8 A-06 {{$timestamp}}\",\n  \"precio\": 0,\n  \"stock\": -1,\n  \"estado\": true,\n  \"categoriaId\": {{catActiva}}\n}",
